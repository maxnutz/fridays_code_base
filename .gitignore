# pixi environments
.pixi/*
!.pixi/config.toml

# shared datasets — not checked in (keep folder structure via .gitkeep)
/resources/*
!/resources/.gitkeep
!/resources/*/
/resources/*/*
!/resources/*/.gitkeep

# per-subfolder generated outputs — not checked in (keep folders via .gitkeep)
*/output/*
!*/output/.gitkeep

# python / tooling caches
__pycache__/
*.py[cod]
.ipynb_checkpoints/
__marimo__/
.ruff_cache/

# secrets / local env
.env

# editor
.vscode/

# logs
*.log
